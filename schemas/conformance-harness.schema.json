{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-harness.schema.json",
  "title": "Edge Canon conformance harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "standardId", "suiteId", "status", "executionKind",
    "fixturePath", "fixtureDependencyPaths", "calibrationPath", "oraclePath",
    "observationSchema", "coveredCaseIds"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "standardId": {"type": "string", "minLength": 1},
    "suiteId": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
    "status": {"enum": ["draft", "complete"]},
    "executionKind": {"enum": ["provider-deployment", "local-artifact"]},
    "fixturePath": {"type": "string", "minLength": 1},
    "fixtureDependencyPaths": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "calibrationPath": {"type": ["string", "null"], "minLength": 1},
    "oraclePath": {"type": "string", "minLength": 1},
    "observationSchema": {"type": "string", "minLength": 1},
    "providerProtocol": {"type": "string", "minLength": 1},
    "providerAdapterSchema": {"type": "string", "minLength": 1},
    "providerAdapterRequestSchema": {"type": "string", "minLength": 1},
    "providerAdapterResultSchema": {"type": "string", "minLength": 1},
    "canonicalArtifactSchema": {"type": "string", "minLength": 1},
    "derivedArtifactSchema": {"type": "string", "minLength": 1},
    "providerDeploymentStateSchema": {"type": "string", "minLength": 1},
    "providerInvocationStateSchema": {"type": "string", "minLength": 1},
    "providerCollectionStateSchema": {"type": "string", "minLength": 1},
    "canonicalArtifactBuilder": {"type": "string", "minLength": 1},
    "artifactSchema": {"type": "string", "minLength": 1},
    "validatorPath": {"type": "string", "minLength": 1},
    "runnerPath": {"type": "string", "minLength": 1},
    "platforms": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"enum": ["linux", "macos", "windows"]}
    },
    "coveredCaseIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EC-[A-Z0-9-]+-T[0-9]{3}$"}
    },
    "providerAdapters": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers"]}
    },
    "providerAdapterPaths": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"executionKind": {"const": "provider-deployment"}}},
      "then": {
        "required": [
          "providerProtocol", "providerAdapterSchema", "providerAdapterRequestSchema",
          "providerAdapterResultSchema", "canonicalArtifactSchema", "derivedArtifactSchema",
          "providerDeploymentStateSchema", "providerInvocationStateSchema",
          "providerCollectionStateSchema", "canonicalArtifactBuilder",
          "providerAdapterPaths", "providerAdapters"
        ]
      },
      "else": {
        "required": ["artifactSchema", "validatorPath", "runnerPath", "platforms"]
      }
    }
  ]
}
