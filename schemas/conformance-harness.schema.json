{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-harness.schema.json",
  "title": "Edge Canon conformance harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "standardId", "suiteId", "status", "fixturePath", "fixtureDependencyPaths",
    "calibrationPath",
    "oraclePath", "observationSchema", "providerProtocol", "coveredCaseIds",
    "providerAdapters"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "standardId": {"type": "string", "minLength": 1},
    "suiteId": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
    "status": {"enum": ["draft", "complete"]},
    "fixturePath": {"type": "string", "minLength": 1},
    "fixtureDependencyPaths": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "calibrationPath": {"type": ["string", "null"], "minLength": 1},
    "oraclePath": {"type": "string", "minLength": 1},
    "observationSchema": {"type": "string", "minLength": 1},
    "providerProtocol": {"type": "string", "minLength": 1},
    "coveredCaseIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EC-[A-Z0-9-]+-T[0-9]{3}$"}
    },
    "providerAdapters": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers"]}
    }
  }
}
