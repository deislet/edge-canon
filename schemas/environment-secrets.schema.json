{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/environment-secrets.schema.json",
  "title": "Edge Canon environment and secret declarations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "standardVersion",
    "access",
    "limits",
    "declarations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "format": {"const": "edge-canon.environment-secrets/v1"},
    "standardVersion": {
      "type": "string",
      "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "extraProviderBindings"],
      "properties": {
        "surface": {"const": "context.env"},
        "extraProviderBindings": {"const": "excluded"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingCount", "valueBytes", "measurement"],
      "properties": {
        "bindingCount": {"const": 64},
        "valueBytes": {"const": 5120},
        "measurement": {"const": "utf-8"}
      }
    },
    "declarations": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/declaration"}
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "valueType", "required"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "kind": {"enum": ["config", "secret"]},
        "valueType": {"enum": ["string", "json"]},
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "secret"}}
          },
          "then": {"properties": {"valueType": {"const": "string"}}}
        }
      ]
    }
  }
}
