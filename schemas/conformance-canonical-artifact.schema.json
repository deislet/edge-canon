{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-canonical-artifact.schema.json",
  "title": "Edge Canon canonical conformance artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "artifactFormat", "standardVersion", "suiteId", "entrypoint", "files"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactFormat": {"const": "edge-canon.canonical-artifact/v1"},
    "standardVersion": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"},
    "suiteId": {"const": "EC-WEB"},
    "entrypoint": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
