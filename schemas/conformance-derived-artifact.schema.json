{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-derived-artifact.schema.json",
  "title": "Edge Canon provider-derived conformance artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "artifactFormat", "standardVersion", "suiteId", "backendId",
    "canonicalArtifactSha256", "inputs", "entrypoint", "files"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactFormat": {"const": "edge-canon.provider-derived-artifact/v1"},
    "standardVersion": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"},
    "suiteId": {"const": "EC-WEB"},
    "backendId": {"enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers"]},
    "canonicalArtifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "compatibilityDate", "cpuIterations", "calibratedCpuMilliseconds", "calibratedWorkSha256"],
      "properties": {
        "projectName": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "compatibilityDate": {"type": "string", "format": "date"},
        "cpuIterations": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "calibratedCpuMilliseconds": {"type": "number", "minimum": 8, "maximum": 10},
        "calibratedWorkSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entrypoint": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\]+$"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
