{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/routing-static-assets.schema.json",
  "title": "Edge Canon routing and static assets semantic document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "format", "standardVersion", "matching", "assets",
    "redirects", "rewrites", "headers", "functions", "fallback"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "format": {"const": "edge-canon.routing-static-assets/v1"},
    "standardVersion": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"},
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "caseSensitive", "query", "rewritePasses", "assetFunctionPrecedence"],
      "properties": {
        "input": {"const": "normalized-url-pathname"},
        "caseSensitive": {"const": true},
        "query": {"const": "excluded-from-match"},
        "rewritePasses": {"const": 1},
        "assetFunctionPrecedence": {"const": "asset-first"}
      }
    },
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "redirects": {"type": "array", "items": {"$ref": "#/$defs/redirect"}},
    "rewrites": {"type": "array", "items": {"$ref": "#/$defs/rewrite"}},
    "headers": {"type": "array", "items": {"$ref": "#/$defs/headerRule"}},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/functionRoute"}},
    "fallback": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": {"kind": {"const": "not-found"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "filePath"],
          "properties": {"kind": {"const": "custom-404"}, "filePath": {"$ref": "#/$defs/filePath"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "filePath"],
          "properties": {"kind": {"const": "spa"}, "filePath": {"$ref": "#/$defs/filePath"}}
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ruleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "sourcePattern": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^/[ -~]*$", "not": {"pattern": "[?#\\\\]"}},
    "pathTemplate": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^/[ -~]*$", "not": {"pattern": "[?#\\\\]"}},
    "urlPath": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/[^?#\\u0000-\\u001f\\u007f\\\\]*$"},
    "filePath": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[:*?\"<>|\\u0000-\\u001f\\u007f])(?!.*(?:^|/)[^/]*[. ](?:/|$)).+$"},
    "method": {"type": "string", "pattern": "^(?:\\*|[A-Z][A-Z0-9!#$%&'*+.^_`|~-]{0,31})$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["urlPath", "filePath", "size", "sha256", "mediaType"],
      "properties": {
        "urlPath": {"$ref": "#/$defs/urlPath"},
        "filePath": {"$ref": "#/$defs/filePath"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "redirectDestination": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["path", "https"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "path"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/pathTemplate"}}}},
        {"if": {"properties": {"kind": {"const": "https"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^https://"}}}}
      ]
    },
    "redirect": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "destination", "status", "query"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "source": {"$ref": "#/$defs/sourcePattern"},
        "destination": {"$ref": "#/$defs/redirectDestination"},
        "status": {"enum": [301, 302]},
        "query": {"enum": ["preserve", "discard"]}
      }
    },
    "rewrite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "destination", "query"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "source": {"$ref": "#/$defs/sourcePattern"},
        "destination": {"$ref": "#/$defs/pathTemplate"},
        "query": {"enum": ["preserve", "discard"]}
      }
    },
    "header": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,99}$"},
        "value": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[\\u0020-\\u007e]+$"}
      }
    },
    "headerRule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "values"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "source": {"$ref": "#/$defs/sourcePattern"},
        "values": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/header"}}
      }
    },
    "functionRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "methods", "entrypointId"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "source": {"$ref": "#/$defs/sourcePattern"},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/method"}},
        "entrypointId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
      }
    }
  }
}
