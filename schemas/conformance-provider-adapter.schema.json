{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-provider-adapter.schema.json",
  "title": "Edge Canon conformance provider adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolVersion", "standardId", "suiteId", "backendId",
    "status", "entrypoint", "tool", "credentialEnvironment", "requiredConfiguration",
    "operations", "caseCoverage", "security", "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": "edge-canon.provider-adapter/v1"},
    "standardId": {"type": "string", "minLength": 1},
    "suiteId": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
    "backendId": {
      "enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers"]
    },
    "status": {"enum": ["draft", "complete"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "package", "version", "integrity"],
          "properties": {
            "distribution": {"const": "npm"},
            "package": {"type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "binary", "version", "sourceRevision"],
          "properties": {
            "distribution": {"const": "workspace-binary"},
            "binary": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "credentialEnvironment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "requiredConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "preflight", "prepare", "deploy", "invoke", "collect", "cleanup", "run"],
      "properties": {
        "inspect": {"$ref": "#/$defs/configurationKeys"},
        "preflight": {"$ref": "#/$defs/configurationKeys"},
        "prepare": {"$ref": "#/$defs/configurationKeys"},
        "deploy": {"$ref": "#/$defs/configurationKeys"},
        "invoke": {"$ref": "#/$defs/configurationKeys"},
        "collect": {"$ref": "#/$defs/configurationKeys"},
        "cleanup": {"$ref": "#/$defs/configurationKeys"},
        "run": {"$ref": "#/$defs/configurationKeys"}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "preflight", "prepare", "deploy", "invoke", "collect", "cleanup", "run"],
      "properties": {
        "inspect": {"$ref": "#/$defs/operation"},
        "preflight": {"$ref": "#/$defs/operation"},
        "prepare": {"$ref": "#/$defs/operation"},
        "deploy": {"$ref": "#/$defs/operation"},
        "invoke": {"$ref": "#/$defs/operation"},
        "collect": {"$ref": "#/$defs/operation"},
        "cleanup": {"$ref": "#/$defs/operation"},
        "run": {"$ref": "#/$defs/operation"}
      }
    },
    "caseCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "blockers"],
        "properties": {
          "id": {"type": "string", "pattern": "^EC-[A-Z0-9-]+-T[0-9]{3}$"},
          "status": {"enum": ["pending", "implemented"]},
          "blockers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "secretsInArguments", "maxOutputBytes", "timeoutSeconds", "cleanupAfterRunFailure"],
      "properties": {
        "shell": {"const": false},
        "secretsInArguments": {"const": false},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "cleanupAfterRunFailure": {"const": true}
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  },
  "$defs": {
    "configurationKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remoteSideEffects"],
      "properties": {
        "status": {"enum": ["pending", "implemented"]},
        "remoteSideEffects": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "limitations": {"maxItems": 0},
          "operations": {
            "properties": {
              "inspect": {"properties": {"status": {"const": "implemented"}}},
              "preflight": {"properties": {"status": {"const": "implemented"}}},
              "prepare": {"properties": {"status": {"const": "implemented"}}},
              "deploy": {"properties": {"status": {"const": "implemented"}}},
              "invoke": {"properties": {"status": {"const": "implemented"}}},
              "collect": {"properties": {"status": {"const": "implemented"}}},
              "cleanup": {"properties": {"status": {"const": "implemented"}}},
              "run": {"properties": {"status": {"const": "implemented"}}}
            }
          },
          "caseCoverage": {
            "items": {
              "properties": {
                "status": {"const": "implemented"},
                "blockers": {"maxItems": 0}
              }
            }
          }
        }
      }
    }
  ]
}
