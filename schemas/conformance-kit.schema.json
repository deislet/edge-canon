{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-kit.schema.json",
  "title": "Edge Canon conformance kit index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardId", "status", "requirementsRegistry", "suites"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "standardId": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen"]},
    "requirementsRegistry": {"type": "string", "minLength": 1},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "familyId", "fixtureStatus", "oracleStatus", "harnessStatus", "casesPath"],
        "properties": {
          "id": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
          "familyId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "fixtureStatus": {"enum": ["planned", "draft", "complete"]},
          "oracleStatus": {"enum": ["planned", "draft", "complete"]},
          "harnessStatus": {"enum": ["planned", "draft", "complete"]},
          "casesPath": {"type": ["string", "null"]}
        }
      }
    }
  }
}
