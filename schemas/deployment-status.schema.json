{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/deployment-status.schema.json",
  "title": "Edge Canon desired and observed deployment status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "standardVersion",
    "deploymentId",
    "planSha256",
    "state",
    "desiredRoutingGeneration",
    "observedRoutingGeneration",
    "targets",
    "proxies",
    "triggers",
    "gateEvaluations",
    "failureCode",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "format": {"const": "edge-canon.deployment-status/v1"},
    "standardVersion": {
      "type": "string",
      "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"
    },
    "deploymentId": {"$ref": "#/$defs/identity"},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "state": {
      "enum": [
        "created", "preparing", "prepared", "verifying", "ready", "activating",
        "active", "paused", "progressing", "aborting", "rolled-back", "failed",
        "degraded", "reconciling"
      ]
    },
    "desiredRoutingGeneration": {"$ref": "#/$defs/identity"},
    "observedRoutingGeneration": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]
    },
    "targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/targetObservation"}
    },
    "proxies": {
      "type": "array",
      "items": {"$ref": "#/$defs/proxyObservation"}
    },
    "triggers": {
      "type": "array",
      "items": {"$ref": "#/$defs/triggerObservation"}
    },
    "gateEvaluations": {
      "type": "array",
      "items": {"$ref": "#/$defs/gateEvaluation"}
    },
    "failureCode": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^EC_DEPLOY_[A-Z0-9_]+$"}
      ]
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "nullableIdentity": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]
    },
    "targetObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "state", "versionId", "snapshotId", "routingGeneration", "observedAt", "failureCode"],
      "properties": {
        "targetId": {"$ref": "#/$defs/identity"},
        "state": {"enum": ["pending", "preparing", "prepared", "verified", "routable", "active", "draining", "failed"]},
        "versionId": {"$ref": "#/$defs/nullableIdentity"},
        "snapshotId": {"$ref": "#/$defs/nullableIdentity"},
        "routingGeneration": {"$ref": "#/$defs/nullableIdentity"},
        "observedAt": {"type": "string", "format": "date-time"},
        "failureCode": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^EC_DEPLOY_[A-Z0-9_]+$"}]
        }
      }
    },
    "proxyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxyId", "state", "routingGeneration", "observedAt", "failureCode"],
      "properties": {
        "proxyId": {"$ref": "#/$defs/identity"},
        "state": {"enum": ["pending", "prepared", "active", "failed"]},
        "routingGeneration": {"$ref": "#/$defs/nullableIdentity"},
        "observedAt": {"type": "string", "format": "date-time"},
        "failureCode": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^EC_DEPLOY_[A-Z0-9_]+$"}]
        }
      }
    },
    "triggerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggerId", "kind", "state", "candidate", "previousOwner", "observedOwner", "workAdmissionOpen",
        "outstandingLeases", "observedAt", "failureCode"
      ],
      "properties": {
        "triggerId": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["http", "queue", "cron"]},
        "state": {"enum": ["pending", "preparing", "draining", "prepared", "active", "aborting", "aborted", "failed"]},
        "candidate": {"$ref": "#/$defs/owner"},
        "previousOwner": {"$ref": "#/$defs/nullableOwner"},
        "observedOwner": {"$ref": "#/$defs/nullableOwner"},
        "workAdmissionOpen": {"type": "boolean"},
        "outstandingLeases": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        },
        "observedAt": {"type": "string", "format": "date-time"},
        "failureCode": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^EC_DEPLOY_[A-Z0-9_]+$"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "queue"}}},
          "then": {"properties": {"outstandingLeases": {"type": "integer", "minimum": 0}}},
          "else": {"properties": {"outstandingLeases": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "queue"}, "state": {"const": "prepared"}}},
          "then": {"properties": {"workAdmissionOpen": {"const": false}, "outstandingLeases": {"const": 0}}}
        }
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "routingGeneration"],
      "properties": {
        "deploymentId": {"$ref": "#/$defs/identity"},
        "routingGeneration": {"$ref": "#/$defs/identity"}
      }
    },
    "nullableOwner": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/owner"}]
    },
    "gateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "outcome", "windowStartedAt", "windowEndedAt", "sampleCount", "reasonCode"],
      "properties": {
        "gateId": {"$ref": "#/$defs/identity"},
        "outcome": {"enum": ["pass", "fail", "insufficient-data"]},
        "windowStartedAt": {"type": "string", "format": "date-time"},
        "windowEndedAt": {"type": "string", "format": "date-time"},
        "sampleCount": {"type": "integer", "minimum": 0},
        "reasonCode": {"type": "string", "pattern": "^EC_DEPLOY_[A-Z0-9_]+$"}
      }
    }
  }
}
