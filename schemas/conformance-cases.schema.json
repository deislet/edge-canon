{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-cases.schema.json",
  "title": "Edge Canon provider-independent conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardId", "suiteId", "status", "executionModel", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "standardId": {"type": "string", "minLength": 1},
    "suiteId": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
    "status": {"enum": ["draft", "frozen"]},
    "executionModel": {"const": "provider-independent-oracle"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "clauseIds", "fixture", "oracle"],
        "properties": {
          "id": {"type": "string", "pattern": "^EC-[A-Z0-9-]+-T[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["normal", "boundary", "failure", "security", "upgrade"]},
          "clauseIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"}
          },
          "fixture": {
            "type": "object", "additionalProperties": false,
            "required": ["scenario", "requirements"],
            "properties": {
              "scenario": {"type": "string", "minLength": 1},
              "requirements": {
                "type": "array", "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "oracle": {
            "type": "object", "additionalProperties": false,
            "required": ["observations", "assertions"],
            "properties": {
              "observations": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "assertions": {
                "type": "array", "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
