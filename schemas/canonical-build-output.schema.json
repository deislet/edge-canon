{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/canonical-build-output.schema.json",
  "title": "Edge Canon canonical build output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "format", "standard", "content", "documents", "build"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "format": {"const": "edge-canon.build-output/v1"},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "edge-canon.next"},
        "version": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "rootSha256", "files"],
      "properties": {
        "algorithm": {"const": "edge-canon.file-set-sha256/v1"},
        "rootSha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/document"}
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceTreeSha256", "buildPlanSha256", "dependencyLockSha256",
        "publicInputsSha256", "sourceDateEpoch", "networkAccess",
        "secretInputsUsed", "toolchains"
      ],
      "properties": {
        "sourceTreeSha256": {"$ref": "#/$defs/sha256"},
        "buildPlanSha256": {"$ref": "#/$defs/sha256"},
        "dependencyLockSha256": {"$ref": "#/$defs/sha256"},
        "publicInputsSha256": {"$ref": "#/$defs/sha256"},
        "sourceDateEpoch": {"type": "integer", "minimum": 0},
        "networkAccess": {"enum": ["denied", "declared"]},
        "secretInputsUsed": {"type": "boolean"},
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/toolchain"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/))[^\\u0000-\\u001f\\u007f]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "mediaType"],
      "properties": {
        "path": {"$ref": "#/$defs/portablePath"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executableSha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "executableSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
