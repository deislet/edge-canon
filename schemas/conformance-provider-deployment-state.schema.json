{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/edge-canon/schemas/conformance-provider-deployment-state.schema.json",
  "title": "Edge Canon provider deployment state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stateFormat", "operationId", "backendId", "standardVersion",
    "suiteId", "canonicalArtifactSha256", "derivedArtifactSha256", "projectName",
    "status", "provider", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "stateFormat": {"const": "edge-canon.provider-deployment-state/v1"},
    "operationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "backendId": {"enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers"]},
    "standardVersion": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"},
    "suiteId": {"const": "EC-WEB"},
    "canonicalArtifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivedArtifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectName": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "status": {
      "enum": ["deploying", "deployed", "deploy-indeterminate", "cleaning", "cleanup-indeterminate", "cleaned"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "deploymentId", "versionId", "url", "environment"],
      "properties": {
        "projectId": {"type": ["string", "null"], "maxLength": 512},
        "deploymentId": {"type": ["string", "null"], "maxLength": 512},
        "versionId": {"type": ["string", "null"], "maxLength": 512},
        "url": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "environment": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
