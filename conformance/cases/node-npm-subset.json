  "cases": [
    {"id":"EC-NODE-T001","title":"精确 builtin/export 清单可用且清单外失败","kind":"normal","clauseIds":["EC-NODE-API-001","EC-NODE-API-002","EC-NODE-ERR-001"],"fixture":{"scenario":"逐 module 动态 import 并核对选中 export，再校验 unsupported builtin/export","requirements":["Node 24.20.0","capability lock","source validator"]},"oracle":{"observations":["module/export inventory","missing exports","failure codes"],"assertions":["全部锁定 export 为可调用/对象值","无 import-only stub","清单外在执行前失败"]}},
    {"id":"EC-NODE-T002","title":"assert 与 Buffer 保持 Node 字节和错误语义","kind":"normal","clauseIds":["EC-NODE-API-002","EC-NODE-FAIL-004"],"fixture":{"scenario":"执行 deepStrictEqual/throws/rejects 与 Buffer 编码、切片、整数读写","requirements":["node:assert/strict","node:buffer"]},"oracle":{"observations":["encoded bytes","slice aliasing","AssertionError shape"],"assertions":["输出与 Node 24.20.0 一致","错误不变成 noop"]}},
    {"id":"EC-NODE-T003","title":"crypto digest/HMAC/timing 与压缩结果确定","kind":"normal","clauseIds":["EC-NODE-API-002","EC-NODE-CON-004"],"fixture":{"scenario":"固定输入计算 SHA-256、HMAC、timingSafeEqual、gzip/deflate/brotli roundtrip","requirements":["node:crypto","node:zlib"]},"oracle":{"observations":["digest","HMAC","comparison","roundtrip bytes"],"assertions":["摘要固定","比较正确","三种压缩无损"]}},
    {"id":"EC-NODE-T004","title":"EventEmitter 与 diagnostics channel 顺序可观察","kind":"normal","clauseIds":["EC-NODE-API-002","EC-NODE-CON-004"],"fixture":{"scenario":"按顺序注册/触发 listener，并 publish/subscribe diagnostics message","requirements":["node:events","node:diagnostics_channel"]},"oracle":{"observations":["listener trace","once result","diagnostics trace"],"assertions":["同步 FIFO","once 只结算一次","unsubscribe 后不再收到"]}},
    {"id":"EC-NODE-T005","title":"path/url/querystring/util 跨开发机确定","kind":"normal","clauseIds":["EC-NODE-API-002","EC-NODE-CON-003"],"fixture":{"scenario":"固定 POSIX/Win32 路径、URL、query 和 format/inspect 向量","requirements":["node:path","node:url","node:querystring","node:util"]},"oracle":{"observations":["normalized values","parsed fields","formatted strings"],"assertions":["Linux/macOS/Windows reference 输出相同","不读取开发机路径"]}},
    {"id":"EC-NODE-T006","title":"stream/StringDecoder 保持边界、错误与完成顺序","kind":"failure","clauseIds":["EC-NODE-CON-004","EC-NODE-FAIL-004"],"fixture":{"scenario":"多字节字符跨 chunk，通过 Transform pipeline，再注入 stream error","requirements":["node:stream","node:stream/promises","node:string_decoder"]},"oracle":{"observations":["decoded value","pipeline trace","error type"],"assertions":["字符不损坏","pipeline 有序完成","错误不伪装 EOF"]}},
    {"id":"EC-NODE-T007","title":"nextTick/timer/immediate 与 AsyncLocalStorage 精确隔离","kind":"normal","clauseIds":["EC-NODE-API-003","EC-NODE-CON-001","EC-NODE-CON-002","EC-NODE-LIFE-002"],"fixture":{"scenario":"两个并发 context 跨 Promise/nextTick/timer/EventEmitter 记录 store 与调度顺序","requirements":["node:async_hooks","node:process","node:timers"]},"oracle":{"observations":["event order","stores","handle terminal state"],"assertions":["Node 队列顺序精确","store 不串线","句柄可回收"]}},
    {"id":"EC-NODE-T008","title":"package manifest、exports/imports/type 条件解析固定","kind":"normal","clauseIds":["EC-NODE-API-004","EC-NODE-API-005"],"fixture":{"scenario":"合成 ESM/CJS package graph，解析 exports/imports 的 edge-canon/worker/browser/import/require/default 分支","requirements":["synthetic package graph","conditional resolver"]},"oracle":{"observations":["selected targets","canonical specifiers","module types"],"assertions":["条件优先级固定","builtin 不被 package 遮蔽","type 决定源码模式"]}},
    {"id":"EC-NODE-T009","title":"CommonJS 只在构建期转换成静态 ESM","kind":"normal","clauseIds":["EC-NODE-API-004","EC-NODE-LIFE-001"],"fixture":{"scenario":"转换静态 require/module.exports，并扫描最终 artifact","requirements":["CommonJS fixture","ESM transformer"]},"oracle":{"observations":["exports value","artifact imports","runtime require references"],"assertions":["行为保持","artifact 为静态 ESM","无通用运行时 require"]}},
    {"id":"EC-NODE-T010","title":"package-lock v3、integrity 与确定性构建不可漂移","kind":"normal","clauseIds":["EC-NODE-API-006","EC-NODE-CON-003","EC-NODE-ERR-002","EC-NODE-ERR-003"],"fixture":{"scenario":"同一 lock/package bytes 以不同缓存和下载顺序构建，并注入缺失/旧 lock 与篡改 bytes","requirements":["package-lock v3 fixture","sha512 verifier","two build schedules"]},"oracle":{"observations":["graph/artifact identities","lock errors","integrity errors"],"assertions":["两次输出字节相同","错误代码精确","不回退其他版本"]}},
    {"id":"EC-NODE-T011","title":"install hook、native addon 与动态解析预部署拒绝","kind":"security","clauseIds":["EC-NODE-ERR-004","EC-NODE-ERR-005","EC-NODE-LIFE-003","EC-NODE-SEC-004"],"fixture":{"scenario":"依次注入 postinstall、.node、node-gyp、require(expr)、dynamic import 与 child_process","requirements":["package/source validator","negative package fixtures"]},"oracle":{"observations":["failure codes","application executions","generated side effects"],"assertions":["全部在执行前失败","hook 未运行","无 native/进程句柄"]}},
    {"id":"EC-NODE-T012","title":"process 规范值与 env 快照不泄漏宿主/tenant","kind":"security","clauseIds":["EC-NODE-API-003","EC-NODE-SEC-003"],"fixture":{"scenario":"两个 invocation 读取规范 process 值并各自修改 env snapshot，再通过 getBuiltinModule 读取选中模块","requirements":["process facade","two tenant contexts","selected builtin facade"]},"oracle":{"observations":["version/platform","env before/after","host fields","selected builtin fields","virtual path roots"],"assertions":["版本/platform 固定","写入不跨 context","宿主字段不可见","getBuiltinModule 返回精确选中模块且清单外为 undefined","顶层 path 固定为 POSIX 且 resolve 不读取宿主 cwd"]}},
    {"id":"EC-NODE-T013","title":"registry credential、archive path 与缓存隔离","kind":"security","clauseIds":["EC-NODE-SEC-001","EC-NODE-SEC-002","EC-NODE-FAIL-002"],"fixture":{"scenario":"认证 fetch 后扫描输出，并注入 traversal/link/device/case collision 与跨 tenant cache key","requirements":["credential canary","archive validator","content-addressed cache"]},"oracle":{"observations":["artifact/log/provenance bytes","path failures","cache identities"],"assertions":["credential 零泄漏","危险 archive 拒绝","tenant 不共享未验证临时项"]}},
    {"id":"EC-NODE-T014","title":"最低 package 图可构建且失败不提交半成品","kind":"boundary","clauseIds":["EC-NODE-LIMIT-001","EC-NODE-LIMIT-002","EC-NODE-FAIL-001","EC-NODE-FAIL-003"],"fixture":{"scenario":"构建 16 package/1 MiB graph；在 fetch、verify、transform、commit 点故障并模拟运行时缺模块","requirements":["capacity graph","transactional builder","fault injection"]},"oracle":{"observations":["package/octet totals","active deployment","temporary cache state","runtime repair attempts"],"assertions":["正向边界通过","故障不提交","运行时不联网修复"]}},
    {"id":"EC-NODE-T015","title":"精确 lock、provider 派生和升级拒绝一致","kind":"upgrade","clauseIds":["EC-NODE-UPG-001","EC-NODE-UPG-002","EC-NODE-UPG-003"],"fixture":{"scenario":"验证 lock，派生三个 provider artifact strategy，并注入浮动 Node、未知字段、额外 export、条件/lock 变更","requirements":["capability lock mutations","three provider derivations"]},"oracle":{"observations":["failure codes","pre-execution counts","provider strategies"],"assertions":["无效 lock 执行前失败","同一应用面映射恰当执行器","变化必须新标准版本"]}}
  ]
