    {"id":"EC-WEBAPI-T001","title":"URL 与 query 使用锁定 WHATWG 语义","kind":"normal","clauseIds":["EC-WEBAPI-API-001","EC-WEBAPI-CON-002"],"fixture":{"scenario":"解析大小写 host、默认端口、多斜线、relative path、Unicode 与重复 query","requirements":["URL vectors","URLSearchParams mutations"]},"oracle":{"observations":["serialized URLs","query entries"],"assertions":["标准 canonicalization 精确","多斜线保留","重复字段顺序和 stable sort 精确"]}},
    {"id":"EC-WEBAPI-T002","title":"Headers 正规化、合并、排序与输入拒绝确定","kind":"security","clauseIds":["EC-WEBAPI-API-002","EC-WEBAPI-ERR-001","EC-WEBAPI-SEC-003"],"fixture":{"scenario":"操作重复 header 并注入无效 name、NUL 与 CRLF","requirements":["header operation vectors","invalid header vectors"]},"oracle":{"observations":["entries","forEach order","error classes"],"assertions":["name/value 正规化和合并精确","callback 返回值不截断","无效输入同步 TypeError"]}},
    {"id":"EC-WEBAPI-T003","title":"Request constructor、clone 与 method/body 约束精确","kind":"normal","clauseIds":["EC-WEBAPI-API-003","EC-WEBAPI-CON-001"],"fixture":{"scenario":"构造 POST、clone 并独立修改 header/读取 body，同时构造 GET body","requirements":["Request constructor","clone branches","invalid GET body"]},"oracle":{"observations":["properties","branch bodies","header identities","GET error"],"assertions":["method/URL/redirect 精确","clone 独立","GET body 被拒绝"]}},
    {"id":"EC-WEBAPI-T004","title":"Response constructor、静态方法和 body 属性精确","kind":"normal","clauseIds":["EC-WEBAPI-API-004","EC-WEBAPI-ERR-001"],"fixture":{"scenario":"构造普通/error/redirect response 并测试非法状态","requirements":["Response constructor","static response methods","invalid statuses"]},"oracle":{"observations":["status properties","location","error response","error classes"],"assertions":["ok/status/header 精确","五种 redirect status 可用","非法 status 被拒绝"]}},
    {"id":"EC-WEBAPI-T005","title":"body reader 单次消费、clone 与解析失败语义精确","kind":"boundary","clauseIds":["EC-WEBAPI-ERR-002","EC-WEBAPI-CON-001","EC-WEBAPI-FAIL-002"],"fixture":{"scenario":"分别读取 text/arrayBuffer/blob/json/formData，重复读取并注入无效 JSON","requirements":["body reader vectors","consumption checks","parse failures"]},"oracle":{"observations":["reader results","bodyUsed","failure classes"],"assertions":["五类 reader 可用","第二次读取 TypeError","无效 JSON SyntaxError 且无部分值"]}},
    {"id":"EC-WEBAPI-T006","title":"UTF-8 与 binary-string base64 边界固定","kind":"boundary","clauseIds":["EC-WEBAPI-API-005","EC-WEBAPI-API-006","EC-WEBAPI-ERR-002"],"fixture":{"scenario":"编码 Unicode、分块解码、无效 UTF-8、base64 空白/无效/非 Latin-1 输入","requirements":["encoding vectors","base64 vectors"]},"oracle":{"observations":["octets","decoded strings","replacement","error classes"],"assertions":["UTF-8 octet 精确","stream decode 精确","fatal/base64 错误精确"]}},
    {"id":"EC-WEBAPI-T007","title":"AbortSignal 只取消关联 fetch","kind":"failure","clauseIds":["EC-WEBAPI-API-007","EC-WEBAPI-ERR-003","EC-WEBAPI-LIFE-002","EC-WEBAPI-FAIL-001"],"fixture":{"scenario":"并发一个慢 fetch 和一个独立 fetch，只 abort 前者","requirements":["AbortController","delayed HTTP endpoint","independent request"]},"oracle":{"observations":["event count","abort error","independent result","late abort result"],"assertions":["abort 事件一次","关联 Promise 以 AbortError 拒绝","另一 fetch 不受影响","晚 abort 不改写结果"]}},
    {"id":"EC-WEBAPI-T008","title":"Web Crypto 共同子集精确且隔离","kind":"security","clauseIds":["EC-WEBAPI-API-008","EC-WEBAPI-SEC-002"],"fixture":{"scenario":"生成随机 bytes/UUID 并计算已知 SHA-256","requirements":["crypto global","known digest vector"]},"oracle":{"observations":["buffer identity/change","UUID shape","digest"],"assertions":["返回同一 typed array 且填充","UUID v4/variant 正确","SHA-256 精确"]}},
    {"id":"EC-WEBAPI-T009","title":"fetch redirect mode、method 转换与 credential stripping 精确","kind":"security","clauseIds":["EC-WEBAPI-API-009","EC-WEBAPI-ERR-003","EC-WEBAPI-SEC-001","EC-WEBAPI-FAIL-003"],"fixture":{"scenario":"本地双 origin 执行 manual/error/follow、303 POST 和跨 origin credential redirect","requirements":["two HTTP origins","redirect matrix","credential canaries"]},"oracle":{"observations":["manual status","error rejection","final method/body","received credential headers"],"assertions":["三种 mode 精确","303 转 GET","跨 origin credential header 被删除","目标 URL 未被平台改写"]}},
    {"id":"EC-WEBAPI-T010","title":"timer 在同步 turn 后执行且 clear 有效","kind":"normal","clauseIds":["EC-WEBAPI-API-010","EC-WEBAPI-LIFE-002"],"fixture":{"scenario":"记录同步、timeout、interval 顺序并 clear 未开始 timer","requirements":["four timer globals","execution trace"]},"oracle":{"observations":["trace","cleared count","interval count"],"assertions":["同步记录最先","cleared callback 不执行","interval 可停止"]}},
    {"id":"EC-WEBAPI-T011","title":"并发 fetch 的结果关联不受完成顺序影响","kind":"normal","clauseIds":["EC-WEBAPI-CON-003","EC-WEBAPI-FAIL-001"],"fixture":{"scenario":"反向完成多条带唯一 ID 的请求并分别消费 body","requirements":["delayed endpoints","unique request IDs"]},"oracle":{"observations":["completion order","promise/result pairs"],"assertions":["允许乱序完成","每个 Promise 的 header/body 仍属于原请求"]}},
    {"id":"EC-WEBAPI-T012","title":"共同 body、header 与 random 边界可执行","kind":"boundary","clauseIds":["EC-WEBAPI-LIMIT-001","EC-WEBAPI-LIMIT-002","EC-WEBAPI-LIMIT-003"],"fixture":{"scenario":"读取 1,000,000 octet、构造 128/4095 header，并调用 65,536 与 65,537 byte random buffer","requirements":["capacity vectors","boundary digest"]},"oracle":{"observations":["body length/digest","header lengths","random results/errors"],"assertions":["正向边界全部通过","65,537 byte 以 QuotaExceededError 失败"]}},
    {"id":"EC-WEBAPI-T013","title":"网络与解析失败不伪造响应或部分值","kind":"failure","clauseIds":["EC-WEBAPI-ERR-003","EC-WEBAPI-FAIL-002","EC-WEBAPI-FAIL-003"],"fixture":{"scenario":"连接关闭、无效 JSON 与错误目标分别失败，同时验证健康请求","requirements":["network failure endpoint","parse failure","healthy endpoint"]},"oracle":{"observations":["settlement kinds","failure names","healthy response"],"assertions":["失败均拒绝且不产生 HTTP Response","没有部分解析值/错误页","健康请求不受污染"]}},
    {"id":"EC-WEBAPI-T014","title":"精确 capability lock 和 provider 派生要求不可漂移","kind":"upgrade","clauseIds":["EC-WEBAPI-LIFE-001","EC-WEBAPI-UPG-001","EC-WEBAPI-UPG-002","EC-WEBAPI-UPG-003"],"fixture":{"scenario":"验证精确 lock，并注入高 major、浮动版本、未知字段和 provider extension 依赖","requirements":["capability lock mutations","derived configuration assertions"]},"oracle":{"observations":["validation codes","pre-execution counts","derived URL mode","extension surface"],"assertions":["无效 lock 在应用执行前失败","Cloudflare 标准 URL 模式为派生配置","扩展不进入标准必需面"]}}
