{
  "$schema": "../../schemas/conformance-cases.schema.json",
  "schemaVersion": 1,
  "standardId": "edge-canon.next",
  "suiteId": "EC-WEB",
  "status": "draft",
  "executionModel": "provider-independent-oracle",
  "cases": [
    {
      "id": "EC-WEB-T001",
      "title": "唯一默认入口产生同步响应",
      "kind": "normal",
      "clauseIds": ["EC-WEB-API-001", "EC-WEB-API-002"],
      "fixture": {"scenario": "部署仅默认导出 handler 的模块并返回同步 Response", "requirements": ["canonical artifact", "HTTP invocation"]},
      "oracle": {"observations": ["build result", "status", "headers", "body"], "assertions": ["构建成功且只注册一个 HTTP 入口", "调用返回 fixture 定义的响应"]}
    },
    {
      "id": "EC-WEB-T002",
      "title": "异步入口和四个上下文字段",
      "kind": "normal",
      "clauseIds": ["EC-WEB-API-002", "EC-WEB-API-003", "EC-WEB-SEC-002"],
      "fixture": {"scenario": "异步 handler 读取 request、env、params 并登记 waitUntil", "requirements": ["declared environment value", "dynamic route", "evidence sink"]},
      "oracle": {"observations": ["HTTP response", "background evidence", "context key set"], "assertions": ["四个标准字段可用", "标准上下文不出现额外供应商字段", "Promise<Response> 正常兑现"]}
    },
    {
      "id": "EC-WEB-T003",
      "title": "方法统一分派且使用标准 Fetch 值",
      "kind": "normal",
      "clauseIds": ["EC-WEB-API-004", "EC-WEB-API-005"],
      "fixture": {"scenario": "向同一路由发送 GET、POST 与自定义方法并回显标准 Request 数据", "requirements": ["three HTTP methods", "request body", "response body"]},
      "oracle": {"observations": ["entrypoint count", "method", "request body", "response body"], "assertions": ["所有方法进入同一标准入口", "Request 和 Response 通过锁定的 Fetch 子集传递"]}
    },
    {
      "id": "EC-WEB-T004",
      "title": "抛出和拒绝产生固定非泄漏错误",
      "kind": "failure",
      "clauseIds": ["EC-WEB-ERR-001", "EC-WEB-ERR-003"],
      "fixture": {"scenario": "分别同步抛出和异步拒绝含唯一秘密标记的异常", "requirements": ["two failing routes", "structured evidence capture", "origin sentinel"]},
      "oracle": {"observations": ["status", "headers", "body", "failure code", "origin hit count"], "assertions": ["两次均返回固定 500 响应", "正文和响应头不含秘密标记", "失败代码为 EC_HANDLER_THROWN", "未回源且未继续供应商 handler 链"]}
    },
    {
      "id": "EC-WEB-T005",
      "title": "无效返回值产生固定错误",
      "kind": "boundary",
      "clauseIds": ["EC-WEB-ERR-002"],
      "fixture": {"scenario": "handler 正常返回 undefined、字符串和普通对象", "requirements": ["three invalid-result routes", "structured evidence capture"]},
      "oracle": {"observations": ["status", "headers", "body", "failure code"], "assertions": ["每次均返回固定 500 响应", "失败代码为 EC_HANDLER_RESULT_INVALID"]}
    },
    {
      "id": "EC-WEB-T006",
      "title": "并发调用隔离且不承诺顺序",
      "kind": "security",
      "clauseIds": ["EC-WEB-CON-001", "EC-WEB-CON-002", "EC-WEB-SEC-001"],
      "fixture": {"scenario": "并发发送带不同随机标记和延迟的请求，handler 使用模块级计数器但响应只读当前上下文", "requirements": ["parallel invocation", "unique request markers", "controllable delay"]},
      "oracle": {"observations": ["completion order", "context object identity", "response markers"], "assertions": ["测试不要求提交或完成顺序", "每次上下文对象身份不同", "每个响应只含自身请求标记", "不把模块计数器值当作持久性断言"]}
    },
    {
      "id": "EC-WEB-T007",
      "title": "响应流延续到 body 结束",
      "kind": "boundary",
      "clauseIds": ["EC-WEB-LIFE-001"],
      "fixture": {"scenario": "handler 返回分三段延迟产生的响应流", "requirements": ["streaming response", "three chunk sentinels"]},
      "oracle": {"observations": ["handler settlement", "chunk sequence", "body terminal state"], "assertions": ["handler 兑现后仍能收到全部三段数据", "body 正常关闭且未被后端提前截断"]}
    },
    {
      "id": "EC-WEB-T008",
      "title": "后台集合采用独立结算",
      "kind": "failure",
      "clauseIds": ["EC-WEB-LIFE-002", "EC-WEB-LIFE-003"],
      "fixture": {"scenario": "登记三个后台任务，其中第二个拒绝，其余写入证据 sink", "requirements": ["background evidence sink", "one rejected promise", "two successful promises"]},
      "oracle": {"observations": ["HTTP response", "task evidence", "background failure code"], "assertions": ["HTTP 响应不因后台拒绝改变", "第一和第三个任务均完成", "拒绝被记录且没有触发 handler 重试"]}
    },
    {
      "id": "EC-WEB-T009",
      "title": "关闭后的 waitUntil 明确失败",
      "kind": "boundary",
      "clauseIds": ["EC-WEB-LIFE-004"],
      "fixture": {"scenario": "保存 waitUntil 引用并在响应 body 关闭后调用", "requirements": ["lifecycle barrier", "synchronous exception capture"]},
      "oracle": {"observations": ["exception type", "failure code", "background side effect"], "assertions": ["同步抛出 TypeError", "失败代码为 EC_WAIT_UNTIL_CLOSED", "被拒任务没有作为后台任务执行"]}
    },
    {
      "id": "EC-WEB-T010",
      "title": "传输失败不重跑应用",
      "kind": "failure",
      "clauseIds": ["EC-WEB-FAIL-001", "EC-WEB-FAIL-002"],
      "fixture": {"scenario": "handler 记录调用标记并返回长流；客户端读取首段后断开，随后发送探测请求", "requirements": ["disconnect-capable client", "invocation evidence sink", "streaming response"]},
      "oracle": {"observations": ["invocation count", "body cancellation", "background evidence", "probe response"], "assertions": ["断开的调用只执行一次", "不把断开解释为事务回滚", "后续调用不含前次上下文或取消状态"]}
    },
    {
      "id": "EC-WEB-T011",
      "title": "精确版本在不同后端保持同一 oracle",
      "kind": "upgrade",
      "clauseIds": ["EC-WEB-UPG-001", "EC-WEB-UPG-002"],
      "fixture": {"scenario": "从同一锁定版本 canonical artifact 为三个一等后端派生产物并运行本 suite", "requirements": ["artifact identity evidence", "three first-class backend harnesses"]},
      "oracle": {"observations": ["pinned standard version", "derived artifact lineage", "suite outcome"], "assertions": ["所有派生产物指向同一精确标准版本", "后端 harness 使用同一断言集且没有语义 waiver"]}
    }
  ]
}
