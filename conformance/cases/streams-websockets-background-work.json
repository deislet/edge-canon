  "executionModel": "provider-independent-oracle",
  "cases": [
    {"id":"EC-STREAM-T001","title":"identity TransformStream 按字节和顺序传递","kind":"normal","clauseIds":["EC-STREAM-API-001","EC-STREAM-API-004","EC-STREAM-CON-001"],"fixture":{"scenario":"依次写入三个 Uint8Array 并读到 EOF","requirements":["identity TransformStream","byte sentinels"]},"oracle":{"observations":["read chunks","done state","lock state"],"assertions":["bytes 和顺序精确","最终 done 且 value undefined"]}},
    {"id":"EC-STREAM-T002","title":"reader/writer lock 与 release 语义精确","kind":"failure","clauseIds":["EC-STREAM-API-002","EC-STREAM-API-003","EC-STREAM-ERR-001"],"fixture":{"scenario":"重复取得 reader/writer、release 后再取得并对旧句柄操作","requirements":["reader/writer lock probes"]},"oracle":{"observations":["locked flags","error settlements"],"assertions":["重复 lock 失败","release 后可重新取得","旧句柄操作失败"]}},
    {"id":"EC-STREAM-T003","title":"pipeTo 传播背压且保持 FIFO","kind":"normal","clauseIds":["EC-STREAM-API-002","EC-STREAM-API-003","EC-STREAM-CON-001","EC-STREAM-CON-002"],"fixture":{"scenario":"快速 source pipe 到延迟 sink 并记录并发 write","requirements":["delayed sink","operation trace"]},"oracle":{"observations":["write trace","maximum in-flight writes","pipe result"],"assertions":["最多一个 write 未结算","顺序精确","pipe 正常完成"]}},
    {"id":"EC-STREAM-T004","title":"tee 两分支独立且观察相同数据","kind":"normal","clauseIds":["EC-STREAM-API-002","EC-STREAM-CON-003"],"fixture":{"scenario":"tee 后以不同节奏读取两个分支","requirements":["tee source","independent readers"]},"oracle":{"observations":["branch bytes","branch locks"],"assertions":["两个分支完整相同","reader 身份和 lock 独立"]}},
    {"id":"EC-STREAM-T005","title":"error、cancel 与 abort 传播而不伪装 EOF","kind":"failure","clauseIds":["EC-STREAM-ERR-002","EC-STREAM-LIFE-002","EC-STREAM-SEC-001"],"fixture":{"scenario":"source 先出一块后 error，另一个 source 被 cancel，sink 被 abort","requirements":["errored source","cancel callback","abort callback"]},"oracle":{"observations":["partial chunk","read/closed failure","cancel reason","abort reason"],"assertions":["error 以拒绝终止","cancel/abort 恰好传播一次"]}},
    {"id":"EC-STREAM-T006","title":"handler 结算后 Response body 仍可流式完成","kind":"normal","clauseIds":["EC-STREAM-API-005","EC-STREAM-LIFE-001","EC-STREAM-FAIL-001"],"fixture":{"scenario":"handler 返回 Response 后分段写入并正常关闭，另一路已提交后 error","requirements":["streaming Response","lifecycle trace","committed error"]},"oracle":{"observations":["event order","body bytes","error terminal state","HTTP status"],"assertions":["handler 先于 body 结束","正常流完整","错误 body 拒绝且不产生第二个响应"]}},
    {"id":"EC-STREAM-T007","title":"多个 waitUntil 任务独立 all-settled","kind":"normal","clauseIds":["EC-STREAM-API-006","EC-STREAM-CON-004","EC-STREAM-FAIL-002"],"fixture":{"scenario":"登记 resolve/reject/延迟 resolve 三个 Promise","requirements":["invocation context","background settlement sink"]},"oracle":{"observations":["completion order","registered-order settlements","response value"],"assertions":["拒绝不取消其他任务","结果关联登记项","响应不变"]}},
    {"id":"EC-STREAM-T008","title":"waitUntil 输入与关闭边界明确失败","kind":"failure","clauseIds":["EC-STREAM-ERR-004","EC-STREAM-LIFE-003"],"fixture":{"scenario":"登记非 Promise，并在前台关闭后再登记","requirements":["synchronous error capture","closed context"]},"oracle":{"observations":["error names","stable codes","application executions"],"assertions":["两个错误同步 TypeError","关闭后任务不执行"]}},
    {"id":"EC-STREAM-T009","title":"并发 invocation 的流与后台集合隔离","kind":"security","clauseIds":["EC-STREAM-CON-004","EC-STREAM-SEC-002"],"fixture":{"scenario":"两个 invocation 并发传不同 canary 和后台任务","requirements":["two contexts","two byte streams"]},"oracle":{"observations":["stream bodies","background results","object identities"],"assertions":["数据和结果不串线","上下文与句柄不同"]}},
    {"id":"EC-STREAM-T010","title":"64 KiB 共同候选边界以背压传输","kind":"boundary","clauseIds":["EC-STREAM-CON-002","EC-STREAM-LIMIT-001"],"fixture":{"scenario":"以 4 KiB chunk、一次一个未结算 write 传输 65,536 octet","requirements":["capacity vector","digest","write accounting"]},"oracle":{"observations":["length","digest","chunk maximum","maximum outstanding writes"],"assertions":["精确传输 65,536 octet","chunk 和 outstanding write 不越界"]}},
    {"id":"EC-STREAM-T011","title":"非 Uint8Array 与 WebSocket 引用预部署失败","kind":"security","clauseIds":["EC-STREAM-API-007","EC-STREAM-ERR-003","EC-STREAM-SEC-003"],"fixture":{"scenario":"写入 string/object 并扫描 WebSocket/WebSocketPair 源码和依赖","requirements":["byte guard","source validator"]},"oracle":{"observations":["stream error codes","source validation codes","provider globals"],"assertions":["非法 chunk 不被字符串化","WebSocket 引用以固定代码拒绝","应用面没有 provider global"]}},
    {"id":"EC-STREAM-T012","title":"后台工作不承诺自动重试或崩溃恢复","kind":"failure","clauseIds":["EC-STREAM-FAIL-002","EC-STREAM-FAIL-003"],"fixture":{"scenario":"登记一次必失败 task 并模拟平台在未完成 task 前终止","requirements":["attempt counter","abandonment record"]},"oracle":{"observations":["attempt count","retry count","lost task count","response value"],"assertions":["失败只执行一次","没有隐式 retry","未完成任务可丢失"]}},
    {"id":"EC-STREAM-T013","title":"精确 lock、provider 派生与升级拒绝不可漂移","kind":"upgrade","clauseIds":["EC-STREAM-UPG-001","EC-STREAM-UPG-002","EC-STREAM-UPG-003"],"fixture":{"scenario":"验证 lock，并注入高 major、浮动版本、未知字段和 WebSocket policy 改写","requirements":["capability lock mutations","three provider derivations"]},"oracle":{"observations":["failure codes","pre-execution counts","derived policies"],"assertions":["无效 lock 在应用执行前失败","三个后端均派生 identity/waitUntil/WebSocket 拒绝"]}}
  ]
}
