{
  "$schema": "../schemas/standard-contract.schema.json",
  "schemaVersion": 1,
  "contractId": "edge-canon.next",
  "standardVersion": "next",
  "releaseStatus": "proposal",
  "normativeRelease": false,
  "capabilityModel": "single-standard",
  "profiles": [],
  "requirementsRegistry": "standard/requirements.json",
  "governance": {
    "repository": "https://github.com/deislet/edge-canon",
    "proposal": "proposals/0001-unified-platform-contract/README.zh.md",
    "proposalStage": "draft",
    "referenceVendorRule": "mainstream-semantic-intersection",
    "referenceVendors": [
      "cloudflare-workers-pages",
      "tencent-edgeone-makers"
    ]
  },
  "compatibility": {
    "applicationPinsExactStandardVersion": true,
    "publishedVersionsAreImmutable": true,
    "providerRuntimeDetectionForbidden": true,
    "unimplementedMandatoryCapability": "reject-before-deploy",
    "initialNodeBaseline": "24-lts",
    "nodeSubsetIsVersionedByStandard": true
  },
  "resourceGuarantees": {
    "referencePlanBaseline": "lowest-generally-available-free-or-entry-plan",
    "allReferenceVendorsMustMeetBaseline": true,
    "unknownPublicGuarantee": "release-blocker",
    "higherPlanCapacityIsPortable": false
  },
  "semanticDimensions": [
    "api",
    "errors",
    "concurrency-consistency-ordering",
    "lifecycle",
    "minimum-resource-guarantees",
    "security-isolation",
    "failure-recovery",
    "upgrade-migration"
  ],
  "capabilityFamilies": [
    {"id": "web-fetch-events", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "routing-static-assets", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "streams-websockets-background-work", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "web-platform-apis", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "node-npm-subset", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "ssr-streaming-ssr-isr", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "environment-secrets", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "kv-cache-sql-blob", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "queue-schedule-service-binding", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "stateful-objects", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "logical-resource-bindings", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "canonical-build-artifact", "requirement": "mandatory", "definitionStatus": "draft"},
    {"id": "deployment-preview-rollback", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "observability", "requirement": "mandatory", "definitionStatus": "pending"},
    {"id": "data-export-deletion", "requirement": "mandatory", "definitionStatus": "pending"}
  ],
  "artifacts": {
    "canonicalArtifactRequired": true,
    "providerArtifactsDerivedFromCanonical": true,
    "providerResourceIdsAllowedInApplicationSource": false,
    "providerDriversMayUsePinnedOfficialCliOrApi": true
  },
  "conformance": {
    "registry": "conformance/registry.json",
    "kit": "conformance/kit.json",
    "certificationUnit": "complete-standard-version",
    "mandatoryTestsMayBeSkipped": false,
    "semanticWaiversAllowed": false,
    "freshEvidenceRequired": true,
    "complianceImpliesSupport": false
  },
  "initialImplementations": [
    {"id": "deislet", "role": "first-class"},
    {"id": "cloudflare-workers-pages", "role": "first-class"},
    {"id": "tencent-edgeone-makers", "role": "first-class"},
    {"id": "deno", "role": "experimental"}
  ]
}
